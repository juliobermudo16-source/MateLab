<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MateLab" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/matelab_deep</item>
        <item name="android:navigationBarColor">@color/matelab_deep</item>
        <item name="android:windowBackground">@color/matelab_sand</item>
    </style>

    <!-- Splash propio de MateLab: fondo turquesa profundo + icono de Kubo -->
    <style name="Theme.MateLab.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/matelab_deep</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_kubo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/matelab_deep</item>
        <item name="postSplashScreenTheme">@style/Theme.MateLab</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/matelab_deep</item>
    </style>

</resources>
